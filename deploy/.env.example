# Copy to /opt/pastoral/.env, fill every CHANGE_ME, chmod 600.
# Compose reads this file twice: for ${...} interpolation in
# docker-compose.yml AND as the api/worker container environment (env_file).

# ---- deploy machinery -------------------------------------------------
# Image tag currently deployed. deploy.yml rewrites this line on every
# deploy and rolls it back from .tag.prev on a failed health check.
TAG=latest
# Uncomment only for the local smoke test; production uses the defaults.
# SITE_ADDRESS=:80
# HTTP_PORT=8088

# ---- database ----------------------------------------------------------
# Generate: openssl rand -hex 24   (hex: safe inside the URL below)
POSTGRES_PASSWORD=CHANGE_ME
# Must embed the SAME password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://pastoral:CHANGE_ME@postgres:5432/pastoral?sslmode=disable

# ---- api / worker -------------------------------------------------------
PORT=8080
PARISH_TZ=America/Tijuana
# PERMANENT once parishioners subscribe: .ics UIDs are minted from this host.
PUBLIC_BASE_URL=https://pastoral.jesuslab135.com
REDIS_ADDR=redis:6379
# The compose network subnet; Caddy is the only proxy in front of the api.
TRUSTED_PROXY=172.28.0.0/24
# Generate: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME

# ---- SMTP (magic links + difusión email; empty = LogMailer, dev only) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- difusión tuning (defaults match backend/internal/config) -----------
QUIET_START=22
QUIET_END=7
STAGGER_SECONDS=8
