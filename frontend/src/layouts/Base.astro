---
import '@fontsource/marcellus';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Calendario Pastoral — Cristo de Los Álamos',
  description = 'Calendario litúrgico y de actividades de la parroquia del Cristo de Los Álamos: misas, fiestas y lo que cada grupo prepara.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e6" />
    <title>{title}</title>
    <link rel="alternate" type="text/calendar" href="/calendario.ics" title="Calendario pastoral" />
  </head>
  <body>
    <slot />
  </body>
</html>
