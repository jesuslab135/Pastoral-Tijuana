---
import { PARISH_NAME } from '../lib/config';
---

<header class="cabecera">
  <div class="interior">
    <div class="marca">
      <div class="anillo">
        <!-- Filled by the island once it knows the current season. -->
        <div class="disco"></div>
      </div>
      <div>
        <div class="nombre">{PARISH_NAME}</div>
        <div class="kicker">Calendario pastoral</div>
      </div>
    </div>
    <a class="suscribir" href="#suscribirse">Suscribirse</a>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 241, 230, 0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .interior {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 12px 28px;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: none;
  }
  .anillo {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--gold-ring);
    position: relative;
    flex: none;
  }
  .disco {
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--season-swatch, var(--sea-verde-color));
    transition: background calc(0.6s * var(--m)) ease;
  }
  .nombre {
    font: 400 15px/1.15 Marcellus, Georgia, serif;
    letter-spacing: 0.01em;
  }
  .kicker {
    font: 400 9.5px/1.3 'IBM Plex Mono', monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .suscribir {
    flex: none;
    margin-left: auto;
    font: 600 11.5px/1 'IBM Plex Sans', system-ui, sans-serif;
    padding: 11px 15px;
    border-radius: 7px;
    background: var(--panel);
    color: var(--panel-bright);
    transition: transform calc(0.2s * var(--m));
  }
  .suscribir:hover {
    transform: translateY(-1px);
    color: var(--panel-bright);
  }
  @media (max-width: 719px) {
    .interior {
      padding: 11px 16px;
    }
  }
</style>
